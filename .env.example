# ─────────────────────────────────────────────────────────────
# Tarf B2B marketplace — environment variables (copy to .env.local)
# NEXT_PUBLIC_* are exposed to the browser; everything else is server-only.
# ─────────────────────────────────────────────────────────────

# ── App / domains ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Root domain used by the showroom tenant resolver ({slug}.<ROOT_DOMAIN>).
# In local dev use lvh.me (resolves *.lvh.me to 127.0.0.1) or rely on /s/{slug}.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
SHOWROOM_SUBDOMAINS_ENABLED=false
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,hi,zh,es,ar

# ── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL=postgresql://tarf:tarf@localhost:5432/tarf
SEED_ADMIN_EMAIL=admin@tarf.test

# ── Redis (BullMQ + Socket.IO adapter + rate limiting) ──────
REDIS_URL=redis://localhost:6379

# ── Search (Meilisearch) ────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=change-me-master-key
MEILISEARCH_SEARCH_KEY=
MEILISEARCH_INDEX_PREFIX=tarf_dev_

# ── Auth ────────────────────────────────────────────────────
AUTH_SECRET=generate-with-openssl-rand-base64-32
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Real-time chat (Socket.IO server) ───────────────────────
CHAT_WS_PORT=4001
NEXT_PUBLIC_CHAT_WS_URL=ws://localhost:4001
CHAT_JWT_SECRET=generate-with-openssl-rand-base64-32

# ── Payments / escrow ───────────────────────────────────────
PAYMENT_PROVIDER=razorpay # razorpay | stripe | manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
ESCROW_AUTO_RELEASE_DAYS=7
PLATFORM_FEE_PERCENT=2.5

# ── AI (Claude API) ─────────────────────────────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL_ASSISTANT=
AI_MODEL_FAST=
AI_MAX_TOKENS=1024

# ── Storage (S3-compatible or Azure Blob) ───────────────────
STORAGE_PROVIDER=s3 # s3 | azure
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=tarf-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=tarf-uploads
NEXT_PUBLIC_CDN_URL=
UPLOAD_MAX_MB=25

# ── Notifications (email / SMS / WhatsApp) ──────────────────
EMAIL_PROVIDER=smtp # smtp | acs | ses
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Tarf <no-reply@tarf.example>"
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Translation (chat / listings) ───────────────────────────
TRANSLATION_PROVIDER=ai # ai | none

# ── Observability / security ────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
RATE_LIMIT_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000
