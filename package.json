{
  "name": "tarf-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "storage:init": "tsx scripts/storage-init.ts",
    "taxonomy:import": "tsx scripts/import-categories.ts",
    "seed:images": "tsx scripts/seed-images.ts",
    "worker": "tsx --require ./workers/preload.cjs workers/main.ts",
    "search:reindex": "tsx --require ./workers/preload.cjs scripts/search-reindex.ts",
    "seed:demo": "tsx scripts/seed-demo-catalog.ts",
    "search:bench": "tsx --require ./workers/preload.cjs scripts/search-bench.ts",
    "hero:images": "tsx scripts/generate-hero-images.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.11",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.49.0",
    "meilisearch": "^0.62.0",
    "motion": "^13.5.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
